{
  "expo": {
    "name": "offline-ai",
    "slug": "offline-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.offline-ai",
      "appleTeamId": "CGHZ52V89D",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voice transcription runs entirely on-device and needs microphone access to hear what you say."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["./plugins/withStableDiffusionSpmPackage.js"]
  }
}
